      "preference": "system"
    }
  },
  {
    "id": "agent-preset-registry",
    "name": "@deepseek-ai/dsh-agent-preset-registry",
    "config": {
      "default": "standard",
      "selectedDefault": "standard"
    }
  },
  {
    "id": "dsh-memory",
    "config": {
      "scopedMemory": true,
      "seedFromAgentsMd": false,
      "autoSummarize": true,
      "summarizeProvider": "openai",
      "summarizeModel": "${DEFAULT_MODEL}",
      "maxBytes": 10000,
      "scopeMaxBytes": 8000,
      "injectTokens": 2400,
      "consolidateEvery": 1,
      "summarizeDebounceMs": 60000,
      "maxActiveSummaries": 2,
      "redactSecrets": true
    }
  },
  {
    "insert": [
      {
        "id": "mcp-playwright",
        "name": "@deepseek-ai/dsh-mcp-client",
        "config": {
          "transport": "stdio",
          "serverName": "playwright",
          "command": "${NODE_EXECUTABLE}",
          "args": [
            "${DESKTOP_DIR}/node_modules/@playwright/mcp/cli.js",
            "--caps",
            "vision,devtools",
            "--snapshot-boxes",
            "--browser",
            "${BROWSER}",
            "--isolated",
            "--output-dir",
            "${DSH_HOME}/browser-output"
          ],
          "failOnStartupError": false,
          "toolCallTimeoutMs": 600000
        }
      },
      {
        "id": "mcp-playwright-session",
        "name": "@deepseek-ai/dsh-mcp-client",
        "config": {
          "transport": "stdio",
          "serverName": "playwright-session",
          "command": "${NODE_EXECUTABLE}",
          "args": [
            "${DESKTOP_DIR}/node_modules/@playwright/mcp/cli.js",
            "--caps",
            "vision,devtools",
            "--snapshot-boxes",
            "--browser",
            "${BROWSER}",
            "--user-data-dir",
            "${DSH_HOME}/browser-profiles/playwright-session",
            "--output-dir",
            "${DSH_HOME}/browser-output-session"
          ],
          "failOnStartupError": false,
          "toolCallTimeoutMs": 600000
        }
      }
    ]
  },
