              "name": "@deepseek-ai/dsh-command-compact"
            },
            {
              "id": "tool-result-pruner",
              "name": "@deepseek-ai/dsh-compaction-tool-result-pruner",
              "config": {
                "thresholdChars": 8192,
                "headChars": 4096,
                "tailChars": 1024
              }
            },
            {
              "id": "range-commands",
              "name": "${MODULE_URL}/range-commands.mjs"
            }
          ]
        },
        {
          "id": "delegation",
          "name": "cordis:group",
          "group": true,
          "isolate": {
            "workflowEngine": true
          },
          "config": [
            {
              "id": "tool-subagent-control",
