[
  {
    "id": "ui-settings-general",
    "name": "@deepseek-ai/dsh-client-ui-settings-general",
    "config": {
      "welcomeNoticeVersion": "2026-08-13.1"
    }
  },
  {
    "id": "permission",
    "name": "@deepseek-ai/dsh-permission-presets",
    "config": {
      "presets": {
        "read-only": {
          "sandbox": "read-only",
          "approval": "ask"
        },
        "workspace-write": {
          "sandbox": "workspace-write",
          "approval": "ask"
        },
        "danger-full-access": {
          "sandbox": "danger-full-access",
          "approval": "never"
        }
      },
      "defaultPreset": "${PERMISSION_PRESET}"
    }
  },
  {
    "id": "agent-default-model",
    "name": "@deepseek-ai/dsh-agent-default-model",
    "config": {
      "provider": "openai",
      "model": "${DEFAULT_MODEL}",
      "reasoningEffort": "${REASONING_EFFORT}"
    }
  },
  {
    "id": "llm-pi-ai",
    "name": "@deepseek-ai/dsh-llm-pi-ai",
    "config": {
      "providers": {
        "openai": {
          "baseURL": "${PROXY_BASE_URL}",
          "reasoning": "high",
          "models": [
            {
              "id": "deepseek-v4.1-flash",
              "name": "deepseek-v4.1-flash",
              "contextWindow": 1000000,
              "maxTokens": 393216,
              "input": [
                "text",
                "image"
              ],
              "reasoningEfforts": {
                "off": null,
                "minimal": "minimal",
                "low": "low",
                "medium": "medium",
                "high": "high",
                "xhigh": "xhigh",
                "max": "max"
              }
            },
            {
              "id": "glm-5.3-flash",
              "name": "glm-5.3-flash",
              "contextWindow": 1000000,
              "maxTokens": 131072,
              "input": [
                "text",
                "image"
              ],
              "reasoningEfforts": {
                "low": "low",
                "high": "high",
                "max": "max"
              }
            },
            {
              "id": "gpt-6.1-sol",
              "name": "gpt-6.1-sol",
              "contextWindow": 272000,
              "maxTokens": 128000,
              "input": [
                "text",
                "image"
              ],
              "reasoningEfforts": {
                "off": null,
                "minimal": "minimal",
                "low": "low",
                "medium": "medium",
                "high": "high",
                "xhigh": "xhigh",
                "max": "max"
              }
            },
            {
              "id": "gpt-6-luna",
              "name": "gpt-6-luna"
            }
          ],
          "apiKeyEnv": "OPENAI_API_KEY",
          "api": "openai-completions"
        }
      }
    }
  },
  {
    "id": "ui-chat",
    "name": "@deepseek-ai/dsh-client-ui-chat",
    "config": {
      "transcriptView": "standard",
      "performanceUsage": "detailed"
    }
  },
  {
    "id": "ui-settings",
    "name": "@deepseek-ai/dsh-client-ui-settings",
    "config": {
      "enabled": true
    }
  },
  {
    "id": "ui-settings-account",
    "name": "@deepseek-ai/dsh-client-ui-settings-account",
    "config": {
      "version": 1,
      "step": "done",
      "usage": "detailed",
      "developerTools": true,
      "purpose": null,
      "process": "standard",
      "completion": "api-key"
    }
  },
  {
    "id": "locale",
    "name": "@deepseek-ai/dsh-client-locale",
    "config": {
      "preference": "zh"
    }
  },
  {
    "id": "ui-theme",
    "name": "@deepseek-ai/dsh-client-ui-theme",
    "config": {
      "preference": "system"
    }
  },
  {
    "id": "agent-preset-registry",
    "name": "@deepseek-ai/dsh-agent-preset-registry",
    "config": {
      "default": "standard",
      "selectedDefault": "standard"
    }
  },
  {
    "id": "dsh-memory",
    "config": {
      "scopedMemory": true,
      "seedFromAgentsMd": false,
      "autoSummarize": true,
      "summarizeProvider": "openai",
      "summarizeModel": "${DEFAULT_MODEL}",
      "maxBytes": 10000,
      "scopeMaxBytes": 8000,
      "injectTokens": 2400,
      "consolidateEvery": 1,
      "summarizeDebounceMs": 60000,
      "maxActiveSummaries": 2,
      "redactSecrets": true
    }
  },
  {
    "insert": [
      {
        "id": "mcp-playwright",
        "name": "@deepseek-ai/dsh-mcp-client",
        "config": {
          "transport": "stdio",
          "serverName": "playwright",
          "command": "${NODE_EXECUTABLE}",
          "args": [
            "${DESKTOP_DIR}/node_modules/@playwright/mcp/cli.js",
            "--caps",
            "vision,devtools",
            "--snapshot-boxes",
            "--browser",
            "chrome",
            "--isolated",
            "--output-dir",
            "${DSH_HOME}/browser-output"
          ],
          "failOnStartupError": false,
          "toolCallTimeoutMs": 600000
        }
      }
    ]
  },
  {
    "id": "agent-team",
    "disabled": true
  },
  {
    "id": "tool-agent-team",
    "disabled": true
  },
  {
    "insert": [
      {
        "id": "computer-use",
        "name": "@deepseek-ai/dsh-computer-use"
      },
