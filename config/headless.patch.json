[
  {
    "id": "sandbox-policy",
    "config": {
      "mode": "${PERMISSION_PRESET}",
      "workspaceRoot": {
        "$js": "process.cwd()"
      }
    }
  },
  {
    "id": "permission",
    "config": {
      "presets": {
        "read-only": {
          "sandbox": "read-only",
          "approval": "ask"
        },
        "workspace-write": {
          "sandbox": "workspace-write",
          "approval": "ask"
        },
        "danger-full-access": {
          "sandbox": "danger-full-access",
          "approval": "never"
        }
      },
      "defaultPreset": "${PERMISSION_PRESET}"
    }
  },
  {
    "insert": [
      {
        "id": "hooks-claude-code",
        "name": "@deepseek-ai/dsh-hooks-claude-code",
        "config": {
          "configPath": "${DSH_HOME}/claude-hooks.json"
        },
        "disabled": "${HOOKS_DISABLED}"
      }
    ]
  },
  {
    "id": "agent-default-model",
    "name": "@deepseek-ai/dsh-agent-default-model",
    "config": {
      "provider": "openai",
      "model": "${DEFAULT_MODEL}",
      "reasoningEffort": "${REASONING_EFFORT}"
    }
  },
  {
    "id": "llm-pi-ai",
    "name": "@deepseek-ai/dsh-llm-pi-ai",
    "config": {
      "providers": {
        "openai": {
          "baseURL": "${PROXY_BASE_URL}",
          "reasoning": "high",
          "models": [
            {
              "id": "deepseek-v4.1-flash",
              "name": "deepseek-v4.1-flash",
              "contextWindow": 1000000,
              "maxTokens": 393216,
              "input": [
                "text",
                "image"
              ],
              "reasoningEfforts": {
                "off": null,
                "minimal": "minimal",
                "low": "low",
                "medium": "medium",
                "high": "high",
                "xhigh": "xhigh",
                "max": "max"
              }
            },
            {
              "id": "glm-5.3-flash",
              "name": "glm-5.3-flash",
              "contextWindow": 1000000,
              "maxTokens": 131072,
              "input": [
                "text",
                "image"
              ],
              "reasoningEfforts": {
                "off": null,
                "minimal": "minimal",
                "low": "low",
                "medium": "medium",
                "high": "high",
                "xhigh": "xhigh",
                "max": "max"
              }
            },
            {
              "id": "gpt-6.1-sol",
              "name": "gpt-6.1-sol",
              "contextWindow": 272000,
              "maxTokens": 128000,
              "input": [
                "text",
                "image"
              ],
              "reasoningEfforts": {
                "off": null,
                "minimal": "minimal",
                "low": "low",
                "medium": "medium",
                "high": "high",
                "xhigh": "xhigh",
                "max": "max"
              }
            },
            {
              "id": "gpt-6-luna",
              "name": "gpt-6-luna"
            }
          ],
          "apiKeyEnv": "OPENAI_API_KEY",
          "api": "openai-completions"
        }
      }
    }
  },
  {
    "id": "credentials",
    "disabled": false
  },
  {
    "insert": [
      {
        "id": "dsh-memory",
        "config": {
          "scopedMemory": true,
          "seedFromAgentsMd": false,
          "autoSummarize": true,
          "summarizeProvider": "openai",
          "summarizeModel": "${DEFAULT_MODEL}",
          "maxBytes": 10000,
          "scopeMaxBytes": 8000,
          "injectTokens": 2400,
          "consolidateEvery": 1,
          "summarizeDebounceMs": 60000,
          "maxActiveSummaries": 2,
          "redactSecrets": true
        },
        "name": "${MEMORY_URL}"
      }
    ]
  }
]
