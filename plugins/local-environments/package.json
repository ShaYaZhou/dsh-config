{
  "name": "@local/dsh-local-environments",
  "version": "0.1.2",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./pwsh": "./lib/pwsh.js",
    "./subprocess": "./lib/subprocess.js",
    "./values": "./lib/values.js",
    "./catalog": "./lib/catalog.js",
    "./workspace": "./lib/workspace.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./bash": "./lib/bash.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@local/dsh-shared": "0.1.0",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-pwsh-sandbox": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.2 || 0.2.1-rc.3",
    "zod": "^4.0.0",
    "@deepseek-ai/dsh-bash-sandbox": "0.2.1-rc.3"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
